# CrisisMind AI Backend Environment Variables
# Port is determined by deployment environment or defaults to 8000
PORT=8000

# Allowed CORS Origins (comma-separated, or * for all)
CORS_ORIGINS=*

# Optional Gemini LLM API Key (If omitted, system uses deterministic multi-agent simulation)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
